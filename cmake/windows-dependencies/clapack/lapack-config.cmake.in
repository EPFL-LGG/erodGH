get_filename_component(_erod_lapack_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
foreach(_lib f2c blas lapack)
    if(NOT TARGET ${_lib})
        add_library(${_lib} STATIC IMPORTED)
        if(_lib STREQUAL "f2c")
            set(_filename libf2c)
        else()
            set(_filename ${_lib})
        endif()
        set_target_properties(${_lib} PROPERTIES IMPORTED_LOCATION "${_erod_lapack_prefix}/lib/${_filename}.lib")
    endif()
endforeach()
set_target_properties(blas PROPERTIES INTERFACE_LINK_LIBRARIES f2c)
set_target_properties(lapack PROPERTIES INTERFACE_LINK_LIBRARIES "blas;f2c")
set(BLAS_FOUND TRUE)
set(LAPACK_FOUND TRUE)
set(BLAS_LIBRARIES blas)
set(LAPACK_LIBRARIES lapack)
