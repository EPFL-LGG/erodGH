# Shared options for upstream SuiteSparse on Windows and macOS.
# Only build the solvers used by MeshFEM and their ordering/config dependencies.
set(SUITESPARSE_ENABLE_PROJECTS "cholmod;umfpack" CACHE STRING "")
set(SUITESPARSE_DEMOS OFF CACHE BOOL "")
set(SUITESPARSE_USE_CUDA OFF CACHE BOOL "")
set(SUITESPARSE_USE_OPENMP OFF CACHE BOOL "")
set(SUITESPARSE_USE_FORTRAN OFF CACHE BOOL "")
set(SUITESPARSE_USE_PYTHON OFF CACHE BOOL "")
set(SUITESPARSE_USE_64BIT_BLAS OFF CACHE BOOL "")
set(CHOLMOD_PARTITION OFF CACHE BOOL "")
set(CMAKE_POSITION_INDEPENDENT_CODE ON CACHE BOOL "")
